.git
.gitignore
# Exclude all node_modules by default, then re-include the runtime deps
# the VS Code extension actually needs (js-yaml, markdown-it, pdfkit + their
# transitive trees). ink/ink-text-input are CLI/Conduit-only — devDeps.
node_modules/**
!node_modules/js-yaml/**
!node_modules/argparse/**
!node_modules/markdown-it/**
!node_modules/entities/**
!node_modules/linkify-it/**
!node_modules/mdurl/**
!node_modules/uc.micro/**
!node_modules/punycode.js/**
!node_modules/pdfkit/**
!node_modules/fontkit/**
!node_modules/linebreak/**
!node_modules/png-js/**
!node_modules/restructure/**
!node_modules/tiny-inflate/**
!node_modules/unicode-properties/**
!node_modules/unicode-trie/**
!node_modules/brotli/**
!node_modules/dfa/**
!node_modules/@noble/**
!node_modules/@swc/**
!node_modules/base64-js/**
!node_modules/pako/**
!node_modules/js-md5/**
!node_modules/clone/**
!node_modules/fast-deep-equal/**
!node_modules/tslib/**
.github/**
.vscode/**
.vscode-test/**
.claude/**
backup/**
docs/**
website content/**
site/**
internal/**
test/**
coverage/**
src/cli/**
src/conduit/**
bin/**
dist/**
.c8rc.json
eslint.config.js
scripts/**
media/legacy/**
media/docs-home/**
media/yamlink-labs*.png
media/yamlink-labs*.jpg
media/icon-1.png
tmp/**
site-app-dist/**
graph/build.mjs
**/*.map
**/*.ts
