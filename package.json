{
    "name": "yamlink",
    "displayName": "Yamlink",
    "description": "Turn Markdown notes into editable live tables — change a cell, it writes back to the file. Plus a knowledge graph, calendar, vault intelligence, and CLI/API/terminal access. No database, no sync.",
