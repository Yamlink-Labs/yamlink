{
  "name": "yamlink",
  "displayName": "Yamlink",
  "description": "Turn Markdown into a structured knowledge system. Canonical IDs, vault-wide linking, backlinks, and real-time diagnostics for YAML-based knowledge graphs.",
  "version": "0.3.0",
  "publisher": "yamlink",
  "author": {
    "name": "Javier Ramirez"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/javierigaciorm/yamlink"
  },
  "bugs": {
    "url": "https://github.com/javierigaciorm/yamlink/issues"
  },
  "homepage": "https://github.com/javierigaciorm/yamlink#readme",
  "keywords": [
    "markdown",
    "notes",
    "knowledge-base",
    "knowledge-graph",
    "wikilinks",
    "zettelkasten",
    "pkm",
    "crm",
    "frontmatter",
    "yaml",
    "obsidian",
    "logseq",
    "developer-tools",
    "data-modeling",
    "graph"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Data Science"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onLanguage:markdown",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yamlinkSidebar",
          "title": "Yamlink",
          "icon": "media/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "yamlink.createNote",
        "title": "Yamlink: Create Node"
      },
      {
        "command": "yamlink.newNodeFromTemplate",
        "title": "Yamlink: New Node from Template"
      },
      {
        "command": "yamlink.openHealthPanel",
        "title": "Yamlink: Open Vault Health"
      },
      {
        "command": "yamlink.addFrontmatter",
        "title": "Yamlink: Add Frontmatter"
      },
      {
        "command": "yamlink.linkOrphan",
        "title": "Yamlink: Link this node to another…"
      },
      {
        "command": "yamlink.openView",
        "title": "Open View",
        "category": "Yamlink"
      },
      {
        "command": "yamlink.openHub",
        "title": "Yamlink: Open Note Report",
        "icon": {
          "light": "media/note-report-light.svg",
          "dark": "media/note-report-dark.svg"
        }
      },
      {
        "command": "yamlink.openCalendar",
        "title": "Yamlink: Open Calendar",
        "icon": {
          "light": "media/calendar-light.svg",
          "dark": "media/calendar-dark.svg"
        }
      },
      {
        "command": "yamlink.runViews",
        "title": "Yamlink: Run Views in Current File"
      },
      {
        "command": "yamlink.insertViewBlock",
        "title": "Insert View Block",
        "category": "Yamlink"
      },
      {
        "command": "yamlink.queryBuilder",
        "title": "Yamlink: Query Builder"
      },
      {
        "command": "yamlink.runGraph",
        "title": "Yamlink: Run Graph"
      },
      {
        "command": "yamlink.runVaultGraph",
        "title": "Yamlink: Vault Graph",
        "icon": {
          "light": "media/graph-light.svg",
          "dark": "media/graph-dark.svg"
        }
      },
      {
        "command": "yamlink.exportActiveNotePdf",
        "title": "Yamlink: Export Active Note to PDF"
      },
      {
        "command": "yamlink.copyId",
        "title": "Yamlink: Copy Node ID"
      },
      {
        "command": "yamlink.closeViewPanel",
        "title": "Yamlink: Close View Panel"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "yamlink.addFrontmatter",
          "when": "false"
        },
        {
          "command": "yamlink.linkOrphan",
          "when": "false"
        },
        {
          "command": "yamlink.closeViewPanel",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "yamlink.copyId",
          "when": "editorLangId == markdown",
          "group": "yamlink@1"
        }
      ],
      "editor/title": [
        {
          "command": "yamlink.openHub",
          "when": "editorLangId == markdown",
          "group": "navigation@1"
        },
        {
          "command": "yamlink.openCalendar",
          "when": "editorLangId == markdown",
          "group": "navigation@2"
        },
        {
          "command": "yamlink.runVaultGraph",
          "when": "editorLangId == markdown",
          "group": "navigation@3"
        }
      ]
    },
    "views": {
      "yamlinkSidebar": [
        {
          "id": "yamlink.noteReport",
          "name": "Note Report",
          "type": "webview"
        },
        {
          "id": "yamlink.calendar",
          "name": "Calendar",
          "type": "webview"
        }
      ]
    }
  },
  "dependencies": {
    "js-yaml": "4.1.0",
    "pdfkit": "^0.18.0"
  },
  "scripts": {
    "test": "node --test test/query.test.js test/date.test.js test/calendar.test.js test/rename.test.js test/completion.test.js test/viewPanel.test.js test/viewCodeLens.test.js test/pdfExport.test.js test/suggestions.test.js test/refreshRouter.test.js test/queryBuilder.test.js test/id.test.js test/graphPanel.test.js",
    "test:index": "node --test test/index.test.js",
    "test:date": "node --test test/date.test.js",
    "test:calendar": "node --test test/calendar.test.js",
    "test:rename": "node --test test/rename.test.js",
    "test:runtime": "node --test test/activeViewRuntime.test.js",
    "test:pdf": "node --test test/pdfExport.test.js",
    "test:all": "node --test test/query.test.js test/date.test.js test/calendar.test.js test/rename.test.js test/completion.test.js test/viewPanel.test.js test/viewCodeLens.test.js test/pdfExport.test.js test/suggestions.test.js test/refreshRouter.test.js test/queryBuilder.test.js test/id.test.js test/graphPanel.test.js test/index.test.js test/activeViewRuntime.test.js",
    "test:watch": "node --test --watch test/query.test.js test/date.test.js test/calendar.test.js test/rename.test.js test/completion.test.js test/viewPanel.test.js test/viewCodeLens.test.js test/pdfExport.test.js test/suggestions.test.js test/refreshRouter.test.js test/queryBuilder.test.js test/id.test.js test/graphPanel.test.js",
    "test:ace": "node test/ace.local.js"
  }
}
