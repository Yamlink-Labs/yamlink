{
    "name": "yamlink",
    "displayName": "Yamlink",
    "description": "Markdown note-taking with wikilinks, backlinks, and a knowledge graph for VS Code. Query your notes into editable live tables — edit a cell and it writes back to the file. Graph visualization, calendar, vault intelligence. No database, no sync.",
    "version": "0.7.3",
    "publisher": "yamlink",
    "author": {
        "name": "Yamlink Labs",
        "url": "https://github.com/Yamlink-Labs"
    },
    "license": "MIT",
    "bin": {
        "yamlink": "./bin/yamlink.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Yamlink-Labs/yamlink"
    },
    "bugs": {
        "url": "https://github.com/Yamlink-Labs/yamlink/issues"
    },
    "homepage": "https://github.com/Yamlink-Labs/yamlink#readme",
    "keywords": [
        "markdown",
        "notes",
        "note-taking",
        "wiki",
        "notebook",
        "backlinks",
        "wikilinks",
        "knowledge-graph",
        "knowledge-base",
        "personal-knowledge-management",
        "zettelkasten",
        "second-brain",
        "pkm",
        "obsidian",
        "foam",
        "roam",
        "dataview",
        "logseq",
        "crm",
        "frontmatter",
        "yaml",
        "graph",
        "graph-view",
        "query",
        "structured-markdown",
        "markdown-database",
        "metadata",
        "schema",
        "tables",
        "reporting",
        "dashboard",
        "calendar",
        "cli",
        "terminal",
        "automation",
        "authoring",
        "publishing",
        "knowledge-engine",
        "local-first",
        "productivity",
        "developer-tools"
    ],
    "engines": {
        "vscode": "^1.120.0"
    },
    "categories": [
        "Other",
        "Visualization",
        "Notebooks"
    ],
    "galleryBanner": {
        "color": "#161616",
        "theme": "dark"
    },
    "icon": "media/icon.png",
    "activationEvents": [
        "onLanguage:markdown",
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "yamlinkSidebar",
                    "title": "Yamlink",
                    "icon": "media/icon-1.svg"
                }
            ]
        },
        "commands": [
            {
                "command": "yamlink.openHome",
                "title": "Yamlink: Open Home"
            },
            {
                "command": "yamlink.naturalQuery",
                "title": "Yamlink: Query in Plain English"
            },
            {
                "command": "yamlink.newNote",
                "title": "Yamlink: New Note"
            },
            {
                "command": "yamlink.newNoteFromSelection",
                "title": "Yamlink: New Note from Selection"
            },
            {
                "command": "yamlink.splitNoteBody",
                "title": "Yamlink: Extract Selection to New Note"
            },
            {
                "command": "yamlink.addMissingTemplateFields",
                "title": "Yamlink: Add missing template fields"
            },
            {
                "command": "yamlink.createNote",
                "title": "Yamlink: Create Note"
            },
            {
                "command": "yamlink.newNodeFromTemplate",
                "title": "Yamlink: New Note from Template"
            },
            {
                "command": "yamlink.newNoteFromSchema",
                "title": "Yamlink: New Note from Schema"
            },
            {
                "command": "yamlink.importObsidianVault",
                "title": "Yamlink: Import Obsidian Vault"
            },
            {
                "command": "yamlink.importVaultExport",
                "title": "Yamlink: Import External Vault Export"
            },
            {
                "command": "yamlink.importGitHistory",
                "title": "Yamlink: Import Git History"
            },
            {
                "command": "yamlink.openHealthPanel",
                "title": "Yamlink: Open Vault Health"
            },
            {
                "command": "yamlink.proposeSchema",
                "title": "Yamlink: Propose Schema from Cluster"
            },
            {
                "command": "yamlink.addFrontmatter",
                "title": "Yamlink: Add Frontmatter"
            },
            {
                "command": "yamlink.linkOrphan",
                "title": "Yamlink: Link this note to another…"
            },
            {
                "command": "yamlink.openView",
                "title": "Open View",
                "category": "Yamlink"
            },
            {
                "command": "yamlink.openHub",
                "title": "Yamlink: Open Note Report",
                "icon": {
                    "light": "media/note-report-light.svg",
                    "dark": "media/note-report-dark.svg"
                }
            },
            {
                "command": "yamlink.openCalendar",
                "title": "Yamlink: Open Calendar",
                "icon": {
                    "light": "media/calendar-light.svg",
                    "dark": "media/calendar-dark.svg"
                }
            },
            {
                "command": "yamlink.runViews",
                "title": "Yamlink: Run Views in Current File"
            },
            {
                "command": "yamlink.insertViewBlock",
                "title": "Insert View Block",
                "category": "Yamlink"
            },
            {
                "command": "yamlink.queryBuilder",
                "title": "Yamlink: Query Builder"
            },
            {
                "command": "yamlink.refineViewBlock",
                "title": "Yamlink: Refine View Block"
            },
            {
                "command": "yamlink.runGraph",
                "title": "Yamlink: Open Graph Workspace",
                "icon": {
                    "light": "media/graph-light.svg",
                    "dark": "media/graph-dark.svg"
                }
            },
            {
                "command": "yamlink.runVaultGraph",
                "title": "Yamlink: Open Vault Graph",
                "icon": {
                    "light": "media/graph-light.svg",
                    "dark": "media/graph-dark.svg"
                }
            },
            {
                "command": "yamlink.exportActiveNotePdf",
                "title": "Yamlink: Export Active Note to PDF"
            },
            {
                "command": "yamlink.openLiveNote",
                "title": "Yamlink: Open Live Note"
            },
            {
                "command": "yamlink.copyId",
                "title": "Yamlink: Copy Note ID"
            },
            {
                "command": "yamlink.copyBlockReference",
                "title": "Yamlink: Copy Block Reference"
            },
            {
                "command": "yamlink.copyScopedReference",
                "title": "Yamlink: Copy Scoped Reference"
            },
            {
                "command": "yamlink.copySectionReference",
                "title": "Yamlink: Copy Section Reference"
            },
            {
                "command": "yamlink.insertBlockReference",
                "title": "Yamlink: Insert Block Reference"
            },
            {
                "command": "yamlink.insertScopedReference",
                "title": "Yamlink: Insert Scoped Reference"
            },
            {
                "command": "yamlink.insertSectionReference",
                "title": "Yamlink: Insert Section Reference"
            },
            {
                "command": "yamlink.showPerformanceReport",
                "title": "Yamlink: Show Performance Report"
            },
            {
                "command": "yamlink.resetPerformanceReport",
                "title": "Yamlink: Reset Performance Report"
            },
            {
                "command": "yamlink.closeViewPanel",
                "title": "Yamlink: Close View Panel"
            },
            {
                "command": "yamlink.openNotePreview",
                "title": "Yamlink: Note Preview",
                "icon": {
                    "light": "media/preview-light.svg",
                    "dark": "media/preview-dark.svg"
                }
            },
            {
                "command": "yamlink.openGraphSidebar",
                "title": "Yamlink: Open Graph",
                "icon": {
                    "light": "media/graph-light.svg",
                    "dark": "media/graph-dark.svg"
                }
            },
            {
                "command": "yamlink.backfillCreatedDates",
                "title": "Yamlink: Add Missing Creation Dates"
            },
            {
                "command": "yamlink.openDailyNote",
                "title": "Yamlink: Open Daily Note"
            },
            {
                "command": "yamlink.revealOutlineLine",
                "title": "Yamlink: Go to Heading"
            },
            {
                "command": "yamlink.noteOutlineNextSibling",
                "title": "Yamlink: Next Sibling Section"
            },
            {
                "command": "yamlink.noteOutlinePreviousSibling",
                "title": "Yamlink: Previous Sibling Section"
            },
            {
                "command": "yamlink.noteOutlineSearch",
                "title": "Yamlink: Search Note Outline",
                "icon": {
                    "light": "media/outline-search-light.svg",
                    "dark": "media/outline-search-dark.svg"
                }
            },
            {
                "command": "yamlink.noteOutlineFilterMenu",
                "title": "Yamlink: Note Outline Filters",
                "icon": {
                    "light": "media/outline-filter-light.svg",
                    "dark": "media/outline-filter-dark.svg"
                }
            },
            {
                "command": "yamlink.noteOutlineToggleTasks",
                "title": "Yamlink: Toggle Outline Tasks Filter"
            },
            {
                "command": "yamlink.noteOutlineToggleMentions",
                "title": "Yamlink: Toggle Outline Mentions Filter"
            },
            {
                "command": "yamlink.noteOutlineToggleLinked",
                "title": "Yamlink: Toggle Outline Linked Filter"
            },
            {
                "command": "yamlink.noteOutlineClearFilters",
                "title": "Yamlink: Clear Outline Filters"
            },
            {
                "command": "yamlink.suppressQuerySuggestion",
                "title": "Yamlink: Don't Suggest Views for This Note"
            }
        ],
        "keybindings": [
            {
                "command": "yamlink.newNote",
                "key": "ctrl+alt+n",
                "mac": "cmd+alt+n"
            },
            {
                "command": "yamlink.openDailyNote",
                "key": "ctrl+alt+j",
                "mac": "cmd+alt+j"
            },
            {
                "command": "yamlink.noteOutlineNextSibling",
                "key": "ctrl+alt+down",
                "mac": "cmd+alt+down",
                "when": "editorLangId == markdown"
            },
            {
                "command": "yamlink.noteOutlinePreviousSibling",
                "key": "ctrl+alt+up",
                "mac": "cmd+alt+up",
                "when": "editorLangId == markdown"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "yamlink.addFrontmatter",
                    "when": "false"
                },
                {
                    "command": "yamlink.linkOrphan",
                    "when": "false"
                },
                {
                    "command": "yamlink.closeViewPanel",
                    "when": "false"
                },
                {
                    "command": "yamlink.refineViewBlock",
                    "when": "false"
                },
                {
                    "command": "yamlink.createNote",
                    "when": "false"
                },
                {
                    "command": "yamlink.addMissingTemplateFields",
                    "when": "false"
                },
                {
                    "command": "yamlink.newNoteFromSelection",
                    "when": "false"
                },
                {
                    "command": "yamlink.noteOutlineSearch"
                },
                {
                    "command": "yamlink.noteOutlineFilterMenu"
                },
                {
                    "command": "yamlink.noteOutlineToggleTasks"
                },
                {
                    "command": "yamlink.noteOutlineToggleMentions"
                },
                {
                    "command": "yamlink.noteOutlineToggleLinked"
                },
                {
                    "command": "yamlink.noteOutlineClearFilters"
                },
                {
                    "command": "yamlink.copySectionReference"
                },
                {
                    "command": "yamlink.insertSectionReference"
                },
                {
                    "command": "yamlink.copyScopedReference"
                },
                {
                    "command": "yamlink.insertScopedReference"
                },
                {
                    "command": "yamlink.copyBlockReference"
                },
                {
                    "command": "yamlink.insertBlockReference"
                },
                {
                    "command": "yamlink.openLiveNote"
                }
            ],
            "view/title": [
                {
                    "command": "yamlink.noteOutlineSearch",
                    "when": "view == yamlink.noteOutline",
                    "group": "navigation@1"
                },
                {
                    "command": "yamlink.noteOutlineFilterMenu",
                    "when": "view == yamlink.noteOutline",
                    "group": "navigation@2"
                }
            ],
            "editor/context": [
                {
                    "command": "yamlink.copyId",
                    "when": "editorLangId == markdown",
                    "group": "yamlink@1"
                },
                {
                    "command": "yamlink.copyScopedReference",
                    "when": "editorLangId == markdown",
                    "group": "yamlink@1.25"
                },
                {
                    "command": "yamlink.copyBlockReference",
                    "when": "editorLangId == markdown",
                    "group": "yamlink@1.5"
                },
                {
                    "command": "yamlink.newNoteFromSelection",
                    "when": "editorHasSelection",
                    "group": "yamlink@2"
                },
                {
                    "command": "yamlink.insertScopedReference",
                    "when": "editorLangId == markdown",
                    "group": "yamlink@2.1"
                },
                {
                    "command": "yamlink.insertBlockReference",
                    "when": "editorLangId == markdown",
                    "group": "yamlink@2.5"
                },
                {
                    "command": "yamlink.splitNoteBody",
                    "when": "editorLangId == markdown",
                    "group": "yamlink@3"
                },
                {
                    "command": "yamlink.copySectionReference",
                    "when": "editorLangId == markdown",
                    "group": "yamlink@1.75"
                },
                {
                    "command": "yamlink.insertSectionReference",
                    "when": "editorLangId == markdown",
                    "group": "yamlink@2.25"
                }
            ],
            "view/item/context": [
                {
                    "command": "yamlink.copySectionReference",
                    "when": "view == yamlink.noteOutline && viewItem == yamlinkOutline",
                    "group": "inline@1"
                },
                {
                    "command": "yamlink.copySectionReference",
                    "when": "view == yamlink.noteOutline && viewItem == yamlinkOutlineActive",
                    "group": "inline@1"
                },
                {
                    "command": "yamlink.insertSectionReference",
                    "when": "view == yamlink.noteOutline && viewItem == yamlinkOutline",
                    "group": "inline@2"
                },
                {
                    "command": "yamlink.insertSectionReference",
                    "when": "view == yamlink.noteOutline && viewItem == yamlinkOutlineActive",
                    "group": "inline@2"
                }
            ],
            "editor/title": [
                {
                    "command": "yamlink.openHub",
                    "when": "editorLangId == markdown",
                    "group": "navigation@1"
                },
                {
                    "command": "yamlink.openCalendar",
                    "when": "editorLangId == markdown",
                    "group": "navigation@2"
                },
                {
                    "command": "yamlink.runGraph",
                    "when": "editorLangId == markdown",
                    "group": "navigation@3"
                },
                {
                    "command": "yamlink.openNotePreview",
                    "when": "editorLangId == markdown",
                    "group": "navigation@4"
                },
                {
                    "command": "yamlink.openLiveNote",
                    "when": "editorLangId == markdown",
                    "group": "navigation@4.5"
                },
                {
                    "command": "yamlink.copyScopedReference",
                    "when": "editorLangId == markdown",
                    "group": "navigation@5"
                },
                {
                    "command": "yamlink.insertScopedReference",
                    "when": "editorLangId == markdown",
                    "group": "navigation@6"
                }
            ]
        },
        "views": {
            "yamlinkSidebar": [
                {
                    "id": "yamlink.graph",
                    "name": "Graph",
                    "type": "webview"
                },
                {
                    "id": "yamlink.noteReport",
                    "name": "Note Report",
                    "type": "webview"
                },
                {
                    "id": "yamlink.calendar",
                    "name": "Calendar",
                    "type": "webview"
                },
                {
                    "id": "yamlink.noteOutline",
                    "name": "Note Outline"
                }
            ]
        },
        "configurationDefaults": {
            "[markdown]": {
                "foam.links.hover.enable": false
            }
        },
        "markdown": {
            "markdownItPlugins": true
        },
        "configuration": {
            "title": "Yamlink",
            "properties": {
                "yamlink.concealedWikilinks": {
                    "type": "boolean",
                    "default": false,
                    "description": "Hide [[ and ]] brackets in resolved wikilinks. Shows only the link text (or display alias). Brackets reappear when your cursor enters the link. Default: off."
                },
                "yamlink.taskNotifications.enabled": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Show VS Code notifications for Yamlink tasks that are overdue or due today."
                },
                "yamlink.taskNotifications.includeOverdue": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Include overdue open tasks in Yamlink task notifications."
                },
                "yamlink.taskNotifications.includeDueToday": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Include open tasks due today in Yamlink task notifications."
                },
                "yamlink.taskNotifications.maxItemsPerAlert": {
                    "type": "number",
                    "default": 3,
                    "minimum": 1,
                    "maximum": 10,
                    "scope": "resource",
                    "description": "Maximum number of task items Yamlink considers when building a single notification alert."
                },
                "yamlink.taskNotifications.reminderCooldownMinutes": {
                    "type": "number",
                    "default": 240,
                    "minimum": 0,
                    "maximum": 10080,
                    "scope": "resource",
                    "description": "How long Yamlink waits before repeating the same task notification fingerprint for this vault."
                }
            }
        }
    },
    "dependencies": {
        "js-yaml": "4.1.0",
        "markdown-it": "^14.0.0",
        "pdfkit": "^0.18.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint extension.js src test scripts eslint.config.js",
        "coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary npm test",
        "coverage:check": "c8 --check-coverage --lines 67 --functions 75 --branches 70 --statements 67 npm test",
        "test": "node --test test/activeViewRuntime.test.js test/bodySignals.test.js test/calendar.test.js test/codeActions.integration.test.js test/completion.test.js test/completionCore.test.js test/completionTracker.test.js test/conduit.test.js test/confidence.test.js test/date.test.js test/decorations.test.js test/definition.test.js test/diagnostics.test.js test/driftDetector.test.js test/entityHubController.test.js test/entityHubRecipes.test.js test/fieldCategory.test.js test/fieldPlanner.test.js test/fieldRoles.test.js test/frontmatter.test.js test/frontmatterIntelligence.test.js test/graph.test.js test/graph2Payload.test.js test/graphPanel.test.js test/historyModel.test.js test/hover.test.js test/id.test.js test/ignore.test.js test/gitHistoryImport.test.js test/implicitWeights.test.js test/importObsidian.test.js test/importVaults.test.js test/nlQuery.test.js test/noteArc.test.js test/outcomeCalibration.test.js test/index.test.js test/intelligenceCache.test.js test/lifecycleState.test.js test/mutationEventLog.test.js test/nodeCreationCommands.test.js test/noteRoles.test.js test/pdfExport.test.js test/performanceTracker.test.js test/previewRenderer.test.js test/query.test.js test/queryParser.test.js test/queryBuilder.test.js test/queryCache.test.js test/queryDiagnostics.test.js test/refreshRouter.test.js test/rename.test.js test/schemaRegistry.test.js test/statusRuntime.test.js test/suggestionNoteIndex.test.js test/suggestionCore.test.js test/surface.api.test.js test/surface.cli.test.js test/surface.lsp.test.js test/surface.service.test.js test/taskNotifications.test.js test/unlinkedRefs.test.js test/suggestions.test.js test/surface.completion.test.js test/surface.graph.test.js test/surface.health.test.js test/surface.ignore.test.js test/surface.intelligence.test.js test/surface.mutation.test.js test/surface.noteReport.test.js test/surface.schema.test.js test/surface.view.matrix.test.js test/staleConnectedNotes.test.js test/tagSignals.test.js test/taskCache.test.js test/tasks.test.js test/templateRegistry.test.js test/typeRegistry.test.js test/vaultPriors.test.js test/viewBuilder.test.js test/viewCodeLens.test.js test/viewLightbulb.test.js test/view-table-logic.test.js test/viewPanel.test.js test/viewPanelController.test.js test/writeField.test.js",
