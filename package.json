{
  "name": "yamlink",
  "displayName": "Yamlink",
  "description": "Turn Markdown into a structured knowledge system. Canonical IDs, vault-wide linking, backlinks, and real-time diagnostics for YAML-based knowledge graphs.",
  "version": "0.2.0",
  "publisher": "yamlink",
  "author": {
    "name": "Javier Ramirez"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/javierigaciorm/yamlink"
  },
  "bugs": {
    "url": "https://github.com/javierigaciorm/yamlink/issues"
  },
  "homepage": "https://github.com/javierigaciorm/yamlink#readme",
  "keywords": [
    "markdown",
    "notes",
    "knowledge-base",
    "knowledge-graph",
    "wikilinks",
    "zettelkasten",
    "pkm",
    "crm",
    "frontmatter",
    "yaml",
    "obsidian",
    "logseq",
    "developer-tools",
    "data-modeling",
    "graph"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Data Science"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onLanguage:markdown",
    "onView:yamlink.backlinks",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "yamlink.createNote",
        "title": "Yamlink: Create Node"
      },
      {
        "command": "yamlink.newNodeFromTemplate",
        "title": "Yamlink: New Node from Template"
      },
      {
        "command": "yamlink.openHealthPanel",
        "title": "Yamlink: Open Vault Health"
      },
      {
        "command": "yamlink.addFrontmatter",
        "title": "Yamlink: Add Frontmatter"
      },
      {
        "command": "yamlink.linkOrphan",
        "title": "Yamlink: Link this node to another\u2026"
      },
      {
        "command": "yamlink.runViewFromLens",
        "title": "Run View",
        "category": "Yamlink"
      },
      {
        "command": "yamlink.openView",
        "title": "Open View",
        "category": "Yamlink"
      },
      {
        "command": "yamlink.openHub",
        "title": "Yamlink: Open Entity Hub"
      },
      {
        "command": "yamlink.runViews",
        "title": "Yamlink: Run Views in Current File"
      },
      {
        "command": "yamlink.insertViewBlock",
        "title": "Yamlink: Insert View Block",
        "category": "Yamlink"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "yamlink.addFrontmatter",
          "when": "false"
        },
        {
          "command": "yamlink.linkOrphan",
          "when": "false"
        },
        {
          "command": "yamlink.insertViewBlock",
          "when": "false"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "yamlink.backlinks",
          "name": "Yamlink Backlinks"
        }
      ]
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}