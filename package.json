{
    "name": "yamlink",
    "displayName": "Yamlink",
    "description": "Markdown note-taking with wikilinks, backlinks, and a knowledge graph for VS Code. Query your notes into editable live tables — edit a cell and it writes back to the file. Graph visualization, calendar, vault intelligence. No database, no sync.",
    "version": "0.6.1",
    "publisher": "yamlink",
    "author": {
        "name": "Yamlink Labs",
        "url": "https://github.com/Yamlink-Labs"
    },
    "license": "MIT",
    "bin": {
        "yamlink": "./bin/yamlink.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Yamlink-Labs/yamlink"
    },
    "bugs": {
        "url": "https://github.com/Yamlink-Labs/yamlink/issues"
    },
    "homepage": "https://github.com/Yamlink-Labs/yamlink#readme",
    "keywords": [
        "markdown",
        "notes",
        "note-taking",
        "wiki",
        "notebook",
        "backlinks",
        "wikilinks",
        "knowledge-graph",
        "knowledge-base",
        "personal-knowledge-management",
        "zettelkasten",
        "second-brain",
        "pkm",
        "obsidian",
        "foam",
        "roam",
        "dataview",
        "logseq",
        "crm",
        "frontmatter",
        "yaml",
        "graph",
        "graph-view",
        "query",
        "structured-markdown",
        "markdown-database",
        "metadata",
        "schema",
        "tables",
        "reporting",
        "dashboard",
        "calendar",
        "cli",
        "terminal",
        "automation",
        "authoring",
        "publishing",
        "knowledge-engine",
        "local-first",
        "productivity",
        "developer-tools"
    ],
    "engines": {
        "vscode": "^1.120.0"
    },
    "categories": [
        "Other",
        "Visualization",
        "Notebooks"
    ],
    "galleryBanner": {
        "color": "#161616",
        "theme": "dark"
    },
    "icon": "media/icon.png",
    "activationEvents": [
        "onLanguage:markdown",
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "yamlinkSidebar",
                    "title": "Yamlink",
                    "icon": "media/icon-1.png"
                }
            ]
        },
        "commands": [
            {
                "command": "yamlink.openHome",
                "title": "Yamlink: Open Home"
            },
            {
                "command": "yamlink.naturalQuery",
                "title": "Yamlink: Query in Plain English"
            },
            {
                "command": "yamlink.newNote",
                "title": "Yamlink: New Note"
            },
            {
                "command": "yamlink.newNoteFromSelection",
                "title": "Yamlink: New Note from Selection"
            },
            {
                "command": "yamlink.splitNoteBody",
                "title": "Yamlink: Extract Selection to New Note"
            },
            {
                "command": "yamlink.addMissingTemplateFields",
                "title": "Yamlink: Add missing template fields"
            },
            {
                "command": "yamlink.createNote",
                "title": "Yamlink: Create Note"
            },
            {
                "command": "yamlink.newNodeFromTemplate",
                "title": "Yamlink: New Note from Template"
            },
            {
                "command": "yamlink.newNoteFromSchema",
                "title": "Yamlink: New Note from Schema"
            },
            {
                "command": "yamlink.importObsidianVault",
                "title": "Yamlink: Import Obsidian Vault"
            },
            {
                "command": "yamlink.importGitHistory",
                "title": "Yamlink: Import Git History"
            },
            {
                "command": "yamlink.openHealthPanel",
                "title": "Yamlink: Open Vault Health"
            },
            {
                "command": "yamlink.addFrontmatter",
                "title": "Yamlink: Add Frontmatter"
            },
            {
                "command": "yamlink.linkOrphan",
                "title": "Yamlink: Link this note to another…"
            },
            {
                "command": "yamlink.openView",
                "title": "Open View",
                "category": "Yamlink"
            },
            {
                "command": "yamlink.openHub",
                "title": "Yamlink: Open Note Report",
                "icon": {
                    "light": "media/note-report-light.svg",
                    "dark": "media/note-report-dark.svg"
                }
            },
            {
                "command": "yamlink.openCalendar",
                "title": "Yamlink: Open Calendar",
                "icon": {
                    "light": "media/calendar-light.svg",
                    "dark": "media/calendar-dark.svg"
                }
            },
            {
                "command": "yamlink.runViews",
                "title": "Yamlink: Run Views in Current File"
            },
            {
                "command": "yamlink.insertViewBlock",
                "title": "Insert View Block",
                "category": "Yamlink"
            },
            {
                "command": "yamlink.queryBuilder",
                "title": "Yamlink: Query Builder"
            },
            {
                "command": "yamlink.refineViewBlock",
                "title": "Yamlink: Refine View Block"
            },
            {
                "command": "yamlink.runGraph",
                "title": "Yamlink: Open Graph Workspace",
                "icon": {
                    "light": "media/graph-light.svg",
                    "dark": "media/graph-dark.svg"
                }
            },
            {
                "command": "yamlink.runVaultGraph",
                "title": "Yamlink: Open Vault Graph",
                "icon": {
                    "light": "media/graph-light.svg",
                    "dark": "media/graph-dark.svg"
                }
            },
            {
                "command": "yamlink.exportActiveNotePdf",
                "title": "Yamlink: Export Active Note to PDF"
            },
            {
                "command": "yamlink.copyId",
                "title": "Yamlink: Copy Note ID"
            },
            {
                "command": "yamlink.showPerformanceReport",
                "title": "Yamlink: Show Performance Report"
            },
            {
                "command": "yamlink.resetPerformanceReport",
                "title": "Yamlink: Reset Performance Report"
            },
            {
                "command": "yamlink.closeViewPanel",
                "title": "Yamlink: Close View Panel"
            },
            {
                "command": "yamlink.openNotePreview",
                "title": "Yamlink: Note Preview",
                "icon": {
                    "light": "media/preview-light.svg",
                    "dark": "media/preview-dark.svg"
                }
            },
            {
                "command": "yamlink.openGraphSidebar",
                "title": "Yamlink: Open Graph",
                "icon": {
                    "light": "media/graph-light.svg",
                    "dark": "media/graph-dark.svg"
                }
            },
            {
                "command": "yamlink.backfillCreatedDates",
                "title": "Yamlink: Add Missing Creation Dates"
            },
            {
                "command": "yamlink.openDailyNote",
                "title": "Yamlink: Open Daily Note"
            }
        ],
        "keybindings": [
            {
                "command": "yamlink.newNote",
                "key": "ctrl+alt+n",
                "mac": "cmd+alt+n"
            },
            {
                "command": "yamlink.openDailyNote",
                "key": "ctrl+alt+j",
                "mac": "cmd+alt+j"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "yamlink.addFrontmatter",
                    "when": "false"
                },
                {
                    "command": "yamlink.linkOrphan",
                    "when": "false"
                },
                {
                    "command": "yamlink.closeViewPanel",
                    "when": "false"
                },
                {
                    "command": "yamlink.refineViewBlock",
                    "when": "false"
                },
                {
                    "command": "yamlink.createNote",
                    "when": "false"
                },
                {
                    "command": "yamlink.addMissingTemplateFields",
                    "when": "false"
                },
                {
                    "command": "yamlink.newNoteFromSelection",
                    "when": "false"
                }
            ],
            "editor/context": [
                {
                    "command": "yamlink.copyId",
                    "when": "editorLangId == markdown",
                    "group": "yamlink@1"
                },
                {
                    "command": "yamlink.newNoteFromSelection",
                    "when": "editorHasSelection",
                    "group": "yamlink@2"
                },
                {
                    "command": "yamlink.splitNoteBody",
                    "when": "editorLangId == markdown",
                    "group": "yamlink@3"
                }
            ],
            "editor/title": [
                {
                    "command": "yamlink.openHub",
                    "when": "editorLangId == markdown",
                    "group": "navigation@1"
                },
                {
                    "command": "yamlink.openCalendar",
                    "when": "editorLangId == markdown",
                    "group": "navigation@2"
                },
                {
                    "command": "yamlink.runGraph",
                    "when": "editorLangId == markdown",
                    "group": "navigation@3"
                },
                {
                    "command": "yamlink.openNotePreview",
                    "when": "editorLangId == markdown",
                    "group": "navigation@4"
                }
            ]
        },
        "views": {
            "yamlinkSidebar": [
                {
                    "id": "yamlink.graph",
                    "name": "Graph",
                    "type": "webview"
                },
                {
                    "id": "yamlink.noteReport",
                    "name": "Note Report",
                    "type": "webview"
                },
                {
                    "id": "yamlink.calendar",
                    "name": "Calendar",
                    "type": "webview"
                }
            ]
        },
        "configurationDefaults": {
            "[markdown]": {
                "foam.links.hover.enable": false
            }
        },
        "markdown": {
            "markdownItPlugins": true
        }
    },
    "dependencies": {
        "js-yaml": "4.1.0",
        "markdown-it": "^14.0.0",
        "pdfkit": "^0.18.0"
    },
    "scripts": {
        "build:graph": "node graph/build.mjs",
        "build:graph:watch": "node graph/build.mjs --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint extension.js src test scripts eslint.config.js",
        "coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary npm test",
        "coverage:check": "c8 --check-coverage --lines 67 --functions 75 --branches 70 --statements 67 npm test",
        "test": "node --test test/activeViewRuntime.test.js test/bodySignals.test.js test/calendar.test.js test/codeActions.integration.test.js test/completion.test.js test/completionCore.test.js test/confidence.test.js test/date.test.js test/decorations.test.js test/definition.test.js test/diagnostics.test.js test/driftDetector.test.js test/entityHubController.test.js test/entityHubRecipes.test.js test/fieldCategory.test.js test/fieldPlanner.test.js test/fieldRoles.test.js test/frontmatter.test.js test/frontmatterIntelligence.test.js test/graph.test.js test/graph2Payload.test.js test/graphPanel.test.js test/historyModel.test.js test/hover.test.js test/id.test.js test/ignore.test.js test/gitHistoryImport.test.js test/implicitWeights.test.js test/importObsidian.test.js test/nlQuery.test.js test/noteArc.test.js test/outcomeCalibration.test.js test/index.test.js test/intelligenceCache.test.js test/lifecycleState.test.js test/mutationEventLog.test.js test/nodeCreationCommands.test.js test/noteRoles.test.js test/pdfExport.test.js test/performanceTracker.test.js test/query.test.js test/queryParser.test.js test/queryBuilder.test.js test/queryCache.test.js test/queryDiagnostics.test.js test/refreshRouter.test.js test/rename.test.js test/schemaRegistry.test.js test/statusRuntime.test.js test/suggestionNoteIndex.test.js test/suggestionCore.test.js test/unlinkedRefs.test.js test/suggestions.test.js test/surface.completion.test.js test/surface.graph.test.js test/surface.health.test.js test/surface.ignore.test.js test/surface.intelligence.test.js test/surface.mutation.test.js test/surface.noteReport.test.js test/surface.schema.test.js test/surface.view.matrix.test.js test/tagSignals.test.js test/taskCache.test.js test/tasks.test.js test/templateRegistry.test.js test/typeRegistry.test.js test/vaultPriors.test.js test/viewBuilder.test.js test/viewCodeLens.test.js test/viewLightbulb.test.js test/view-table-logic.test.js test/viewPanel.test.js test/viewPanelController.test.js test/writeField.test.js",
        "test:index": "node --test test/index.test.js",
        "test:date": "node --test test/date.test.js",
        "test:calendar": "node --test test/calendar.test.js",
        "test:rename": "node --test test/rename.test.js",
        "test:runtime": "node --test test/activeViewRuntime.test.js test/performanceTracker.test.js",
        "test:pdf": "node --test test/pdfExport.test.js",
        "test:extension": "node test/runExtensionTests.js",
        "test:smoke": "node test/smoke-carmen.js",
        "test:all": "node --test test/activeViewRuntime.test.js test/bodySignals.test.js test/calendar.test.js test/codeActions.integration.test.js test/completion.test.js test/completionCore.test.js test/confidence.test.js test/date.test.js test/decorations.test.js test/definition.test.js test/diagnostics.test.js test/driftDetector.test.js test/entityHubController.test.js test/entityHubRecipes.test.js test/fieldCategory.test.js test/fieldPlanner.test.js test/fieldRoles.test.js test/frontmatter.test.js test/frontmatterIntelligence.test.js test/gitHistoryImport.test.js test/graph.test.js test/graph2Payload.test.js test/graphPanel.test.js test/historyModel.test.js test/hover.test.js test/id.test.js test/ignore.test.js test/importObsidian.test.js test/index.test.js test/nlQuery.test.js test/noteArc.test.js test/outcomeCalibration.test.js test/intelligenceCache.test.js test/lifecycleState.test.js test/mutationEventLog.test.js test/nodeCreationCommands.test.js test/noteRoles.test.js test/pdfExport.test.js test/performanceTracker.test.js test/query.test.js test/queryParser.test.js test/queryBuilder.test.js test/queryCache.test.js test/queryDiagnostics.test.js test/refreshRouter.test.js test/rename.test.js test/schemaRegistry.test.js test/statusRuntime.test.js test/suggestionNoteIndex.test.js test/suggestionCore.test.js test/unlinkedRefs.test.js test/suggestions.test.js test/surface.completion.test.js test/surface.graph.test.js test/surface.health.test.js test/surface.ignore.test.js test/surface.intelligence.test.js test/surface.mutation.test.js test/surface.noteReport.test.js test/surface.schema.test.js test/surface.view.matrix.test.js test/tagSignals.test.js test/taskCache.test.js test/tasks.test.js test/templateRegistry.test.js test/typeRegistry.test.js test/vaultPriors.test.js test/viewBuilder.test.js test/viewCodeLens.test.js test/viewLightbulb.test.js test/view-table-logic.test.js test/viewPanel.test.js test/viewPanelController.test.js test/writeField.test.js",
        "test:watch": "node --test --watch test/query.test.js test/date.test.js test/calendar.test.js test/rename.test.js test/completion.test.js test/fieldRoles.test.js test/viewPanel.test.js test/viewCodeLens.test.js test/viewLightbulb.test.js test/pdfExport.test.js test/suggestions.test.js test/refreshRouter.test.js test/queryBuilder.test.js test/entityHubRecipes.test.js test/id.test.js test/graphPanel.test.js test/historyModel.test.js test/hover.test.js test/codeActions.integration.test.js test/performanceTracker.test.js",
        "test:ace": "node test/ace.local.js",
        "test:count": "node scripts/check-test-count.js",
        "test:count:update": "node scripts/check-test-count.js --update",
        "site:build": "node site/build.mjs && npx pagefind --site site/dist --output-path site/dist/_pagefind",
        "site:app:dev": "vite --config site-app/vite.config.ts",
        "site:app:build": "vite build --config site-app/vite.config.ts && node site-app/scripts/syncEmbeddedSurfaces.mjs",
        "site:app:preview": "vite preview --config site-app/vite.config.ts"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.13",
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.120.0",
        "@vitejs/plugin-react": "^5.1.0",
        "@vscode/test-electron": "^2.5.2",
        "c8": "^11.0.0",
        "d3-force": "^3.0.0",
        "esbuild": "^0.28.0",
        "eslint": "^10.4.0",
        "highlight.js": "^11.11.1",
        "lucide-react": "^1.16.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tailwindcss": "^4.1.13",
        "typescript": "^5.9.3",
        "vite": "^7.1.7"
    }
}
