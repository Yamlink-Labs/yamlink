        "walkthroughs": [
            {
                "id": "yamlink-tour",
                "title": "Get Started with Yamlink",
                "description": "Learn Yamlink's core loop: create a note, link it, query it, and inspect the system it creates.",
                "steps": [
                    {
                        "id": "yamlink-tour-first-note",
                        "title": "Create your first note",
                        "description": "Every Yamlink note starts with identity. Create a note with an `id:` and a `type:`.\n[New Note](command:yamlink.newNote)",
                        "media": {
                            "markdown": "media/walkthrough/first-note.md"
                        },
                        "completionEvents": [
                            "onCommand:yamlink.newNote"
                        ]
                    },
                    {
                        "id": "yamlink-tour-link-note",
                        "title": "Create a second note and link it",
                        "description": "Make one more note, then add a `[[wikilink]]` between them. This is how Yamlink turns Markdown into relationships.\n[New Note](command:yamlink.newNote)",
                        "media": {
                            "markdown": "media/walkthrough/link-note.md"
                        },
                        "completionEvents": [
                            "onContext:yamlink.tourLinkCreated"
                        ]
                    },
                    {
                        "id": "yamlink-tour-first-view",
                        "title": "Write your first query",
                        "description": "Insert a `!view` block and let Yamlink render it as a live table.\n[Insert View Block](command:yamlink.insertViewBlock)",
                        "media": {
                            "markdown": "media/walkthrough/first-view.md"
                        },
                        "completionEvents": [
                            "onCommand:yamlink.insertViewBlock"
                        ]
                    },
                    {
                        "id": "yamlink-tour-note-report",
                        "title": "Inspect one note deeply",
                        "description": "Open Note Report to see links, tasks, views, and the note's position in the vault.\n[Open Note Report](command:yamlink.openHub)",
                        "media": {
                            "markdown": "media/walkthrough/note-report.md"
                        },
                        "completionEvents": [
                            "onCommand:yamlink.openHub"
                        ]
                    },
                    {
                        "id": "yamlink-tour-system-surfaces",
                        "title": "Inspect the wider system",
                        "description": "Open Home, Calendar, Task Center, Vault Health, and Graph to see your workspace as a living system.\n[Open Home](command:yamlink.openHome)\n[Open Calendar](command:yamlink.openCalendar)\n[Open Task Center](command:yamlink.tasks.focus)\n[Open Vault Health](command:yamlink.openHealthPanel)\n[Open Graph Workspace](command:yamlink.runGraph)",
                        "media": {
                            "markdown": "media/walkthrough/system-surfaces.md"
                        },
                        "completionEvents": [
                            "onCommand:yamlink.openHome",
                            "onCommand:yamlink.openCalendar",
                            "onCommand:yamlink.tasks.focus",
                            "onCommand:yamlink.openHealthPanel",
                            "onCommand:yamlink.runGraph"
                        ]
                    }
                ]
            }
        ],
        "configurationDefaults": {
            "[markdown]": {
                "foam.links.hover.enable": false
            }
        },
        "markdown": {
            "markdownItPlugins": true
        },
        "configuration": {
            "title": "Yamlink",
            "properties": {
                "yamlink.concealedWikilinks": {
                    "type": "boolean",
                    "default": false,
                    "description": "Hide [[ and ]] brackets in resolved wikilinks. Shows only the link text (or display alias). Brackets reappear when your cursor enters the link. Default: off."
                },
                "yamlink.taskNotifications.enabled": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Show VS Code notifications for Yamlink tasks that are overdue or due today."
                },
                "yamlink.taskNotifications.includeOverdue": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Include overdue open tasks in Yamlink task notifications."
                },
                "yamlink.taskNotifications.includeDueToday": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Include open tasks due today in Yamlink task notifications."
                },
                "yamlink.taskNotifications.maxItemsPerAlert": {
                    "type": "number",
                    "default": 3,
                    "minimum": 1,
                    "maximum": 10,
                    "scope": "resource",
                    "description": "Maximum number of task items Yamlink considers when building a single notification alert."
                },
                "yamlink.taskNotifications.reminderCooldownMinutes": {
                    "type": "number",
                    "default": 240,
                    "minimum": 0,
                    "maximum": 10080,
                    "scope": "resource",
                    "description": "How long Yamlink waits before repeating the same task notification fingerprint for this vault."
                },
                "yamlink.glossaryTypes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "scope": "resource",
                    "description": "Which note type(s) count as Vault Glossary terms (e.g. [\"faction\", \"location\"]). Empty by default — Yamlink won't guess which of your types are conceptual versus entity records."
                },
                "yamlink.glossaryGroupByType": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Vault Glossary: show a separate A-Z section per note type instead of one mixed list."
                },
                "yamlink.glossaryShowZeroBacklinkTerms": {
                    "type": "boolean",
                    "default": true,
                    "scope": "resource",
                    "description": "Vault Glossary: show terms nothing links to yet (marked as not yet referenced) instead of hiding them."
                },
                "yamlink.glossaryExtraFields": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "scope": "resource",
                    "description": "Extra frontmatter field names to display under each Vault Glossary entry, if present on that note."
                },
                "yamlink.glossarySortBy": {
                    "type": "string",
                    "enum": [
                        "alphabetical",
                        "mostReferenced"
                    ],
                    "default": "alphabetical",
                    "scope": "resource",
                    "description": "Vault Glossary: order terms alphabetically, or rank by inbound link count (most-referenced first)."
