est/templateRegistry.test.js test/typeRegistry.test.js test/vaultPriors.test.js test/viewBuilder.test.js test/viewCodeLens.test.js test/viewLightbulb.test.js test/view-table-logic.test.js test/viewPanel.test.js test/viewPanelController.test.js test/writeField.test.js",
